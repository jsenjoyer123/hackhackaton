<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.diabase.Diabase</id>

  <name>Diabase</name>
  <summary>Write and sync Markdown notes</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.diabase">
    <name>Jace</name>
  </developer>

  <description>
    <p>
      Diabase is a desktop app for writing Markdown notes in local vaults.
      It keeps notes as files, supports links between notes, and includes
      themes, plugins, and optional Git or WebDAV sync.
    </p>
  </description>

  <launchable type="desktop-id">com.diabase.Diabase.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jsenjoyer123/Diabase/main/assets/image.png</image>
      <caption>Editing a Markdown note in Diabase</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/jsenjoyer123/Diabase</url>
  <url type="bugtracker">https://github.com/jsenjoyer123/Diabase/issues</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="2.1.1" date="2026-05-30">
      <description>
        <p>Fixes Git sync getting stuck after rebase conflicts. Diabase now reports the conflict so it can be resolved.</p>
      </description>
    </release>
  </releases>
</component>
